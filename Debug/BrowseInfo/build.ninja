##IAR Ninja build file


#Rules
rule COMPILER_XCL
  command = "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.2\common\bin\XclFileGenerator.exe" $xclcommand -f "$rspfile_name"
  description = IAR_NEW_TOOL+++COMPILER_XCL+++$out
  rspfile = $rspfile_name
  rspfile_content = $flags

rule INDEXER
  command = "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.2\common\bin\SourceIndexer.exe" $flags
  depfile = $out.dep
  deps = gcc
  description = IAR_NEW_TOOL+++INDEXER+++$out

rule MAKEBROWSE
  command = "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.2\common\bin\makeBrowseData.exe" $flags
  description = IAR_NEW_TOOL+++MAKEBROWSE+++$out

rule PDBLINK
  command = "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.2\common\bin\PbdLink.exe" $flags
  description = IAR_NEW_TOOL+++PDBLINK+++$out



#Build steps
build D$:\Embedded\project\Debug\BrowseInfo\app.xcl : COMPILER_XCL 
    flags = D$:\Embedded\project\app.c -o D$:\Embedded\project\Debug\Obj\ --no_cse --no_unroll --no_inline --no_code_motion --no_tbaa --no_clustering --no_scheduling --debug --endian=little --cpu=Cortex-M0+ -e --fpu=None --dlib_config "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.2\arm\inc\c\DLib_Config_Normal.h" -On --predef_macros D$:\Embedded\project\Debug\BrowseInfo\app.tmp
    rspfile_name = D$:\Embedded\project\Debug\BrowseInfo\app.xcl.rsp
    xclcommand = -source_file D$:\Embedded\project\app.c -xcl_file D$:\Embedded\project\Debug\BrowseInfo\app.xcl -macro_file D$:\Embedded\project\Debug\BrowseInfo\app.tmp -icc_path "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.2\arm\bin\iccarm.exe"

build D$:\Embedded\project\Debug\BrowseInfo\test_app.xcl : COMPILER_XCL 
    flags = D$:\Embedded\project\test_app.c -o D$:\Embedded\project\Debug\Obj\ --no_cse --no_unroll --no_inline --no_code_motion --no_tbaa --no_clustering --no_scheduling --debug --endian=little --cpu=Cortex-M0+ -e --fpu=None --dlib_config "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.2\arm\inc\c\DLib_Config_Normal.h" -On --predef_macros D$:\Embedded\project\Debug\BrowseInfo\test_app.tmp
    rspfile_name = D$:\Embedded\project\Debug\BrowseInfo\test_app.xcl.rsp
    xclcommand = -source_file D$:\Embedded\project\test_app.c -xcl_file D$:\Embedded\project\Debug\BrowseInfo\test_app.xcl -macro_file D$:\Embedded\project\Debug\BrowseInfo\test_app.tmp -icc_path "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.2\arm\bin\iccarm.exe"

build D$:\Embedded\project\Debug\BrowseInfo\app.pbi : INDEXER D$:\Embedded\project\Debug\BrowseInfo\app.xcl | D$:\Embedded\project\app.c
    flags = -out=D$:\Embedded\project\Debug\BrowseInfo\app.pbi -f D$:\Embedded\project\Debug\BrowseInfo\app.xcl

build D$:\Embedded\project\Debug\BrowseInfo\test_app.pbi : INDEXER D$:\Embedded\project\Debug\BrowseInfo\test_app.xcl | D$:\Embedded\project\test_app.c
    flags = -out=D$:\Embedded\project\Debug\BrowseInfo\test_app.pbi -f D$:\Embedded\project\Debug\BrowseInfo\test_app.xcl

build D$:\Embedded\project\Debug\BrowseInfo\project.pbw : MAKEBROWSE D$:\Embedded\project\Debug\BrowseInfo\project.pbd
    flags = D$:\Embedded\project\Debug\BrowseInfo\project.pbd -output D$:\Embedded\project\Debug\BrowseInfo\project.pbw

build D$:\Embedded\project\Debug\BrowseInfo\project.pbd : PDBLINK D$:\Embedded\project\Debug\BrowseInfo\app.pbi | D$:\Embedded\project\Debug\BrowseInfo\test_app.pbi
    flags = -M D$:\Embedded\project\Debug\BrowseInfo\project.pbd D$:\Embedded\project\Debug\BrowseInfo\app.pbi D$:\Embedded\project\Debug\BrowseInfo\test_app.pbi

